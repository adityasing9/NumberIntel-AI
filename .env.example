# ==========================================
# NumberIntel AI — Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="NumberIntel AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Secrets
# Generate a strong 32+ character random string for production
SECRET_KEY="replace-with-a-very-secure-jwt-secret-key-32-bytes-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Credential Encryption Key (Fernet 32-byte url-safe base64 string)
CREDENTIAL_ENCRYPTION_KEY="z0v2e_uJvD7EaYgDk2C9L8tqO4fR3sW1xA5bN6mP7iE="

# Database Connection
# SQLite fallback (Default zero-config local run):
DATABASE_URL="sqlite:///./numberintel.db"
# MySQL Production:
# DATABASE_URL="mysql+pymysql://numberintel_user:numberintel_pass@localhost:3306/numberintel?charset=utf8mb4"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
CELERY_CONCURRENCY=4

# OpenRouter AI Model Configuration
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
OPENROUTER_FALLBACK_MODEL="openai/gpt-4o"

# OSINT & External Providers
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_CX=""
BING_SEARCH_API_KEY=""
NUMVERIFY_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Compliance & Operational Defaults
DEFAULT_COUNTRY="IN"
MAX_BULK_BATCH_SIZE=10000
DATA_RETENTION_DAYS=90
